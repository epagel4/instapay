        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Recusas de negócio (4xx) por endpoint",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{application=\"payment-service\",outcome=\"CLIENT_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{uri}} {{status}}"
